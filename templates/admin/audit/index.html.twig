{% extends 'base.html.twig' %}
{% block title %}Audit trail{% endblock %}
{% block page_title %}Audit trail{% endblock %}
{% set church_name = null %}

{% block topbar_actions %}
{% if is_granted('ROLE_SYSADMIN') %}
<a href="{{ path('admin_audit_verify') }}" class="text-sm text-gray-600 hover:text-gray-800 underline">Verify integrity</a>
{% endif %}
{% endblock %}

{% block content %}
<form method="get" class="flex flex-wrap gap-3 mb-5 bg-white rounded-xl border border-gray-200 p-4">
    <select name="action" class="rounded-lg border border-gray-300 px-3 py-2 text-sm">
        <option value="">All actions</option>
        {% for a in actions %}<option value="{{ a }}" {{ filters.action == a ? 'selected' }}>{{ a }}</option>{% endfor %}
    </select>
    <input name="from" type="date" value="{{ filters.from ? filters.from|date('Y-m-d') : '' }}"
           class="rounded-lg border border-gray-300 px-3 py-2 text-sm">
    <input name="to" type="date" value="{{ filters.to ? filters.to|date('Y-m-d') : '' }}"
           class="rounded-lg border border-gray-300 px-3 py-2 text-sm">
    <button type="submit" class="px-4 py-2 bg-brand-600 text-white rounded-lg text-sm font-medium">Filter</button>
    <a href="{{ path('admin_audit_index') }}" class="px-4 py-2 border border-gray-300 rounded-lg text-sm text-gray-600 hover:bg-gray-50">Reset</a>
</form>

<div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
                <th class="text-left px-4 py-3 text-xs font-semibold text-gray-600 uppercase">When</th>
                <th class="text-left px-4 py-3 text-xs font-semibold text-gray-600 uppercase">User</th>
                <th class="text-left px-4 py-3 text-xs font-semibold text-gray-600 uppercase">Action</th>
                <th class="text-left px-4 py-3 text-xs font-semibold text-gray-600 uppercase hidden md:table-cell">Entity</th>
                <th class="text-left px-4 py-3 text-xs font-semibold text-gray-600 uppercase hidden lg:table-cell">Details</th>
                <th class="text-left px-4 py-3 text-xs font-semibold text-gray-600 uppercase hidden lg:table-cell">IP</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
        {% for log in result.rows %}
        <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 text-gray-500 text-xs whitespace-nowrap">{{ log.createdAt ? log.createdAt|date('d M Y H:i') : '—' }}</td>
            <td class="px-4 py-3 text-gray-700">{{ log.userName ?? ('user #' ~ log.userId) }}</td>
            <td class="px-4 py-3">
                <span class="px-2 py-0.5 rounded text-xs font-medium
                    {{ log.action in ['create'] ? 'bg-green-100 text-green-700' : '' }}
                    {{ log.action in ['update'] ? 'bg-blue-100 text-blue-700' : '' }}
                    {{ log.action in ['delete'] ? 'bg-red-100 text-red-700' : '' }}
                    {{ log.action in ['login','logout'] ? 'bg-gray-100 text-gray-600' : '' }}
                    {{ log.action in ['report','export'] ? 'bg-violet-100 text-violet-700' : '' }}">
                    {{ log.action }}
                </span>
            </td>
            <td class="px-4 py-3 text-gray-600 hidden md:table-cell">{{ log.entity ? (log.entity ~ (log.entityId ? ' #' ~ log.entityId : '')) : '—' }}</td>
            <td class="px-4 py-3 text-gray-500 text-xs hidden lg:table-cell max-w-xs truncate">
                {{ log.detailsRaw ? (log.detailsRaw|length > 80 ? log.detailsRaw|slice(0,80) ~ '…' : log.detailsRaw) : '—' }}
            </td>
            <td class="px-4 py-3 text-gray-400 text-xs hidden lg:table-cell">{{ log.ipAddress ?? '—' }}</td>
        </tr>
        {% else %}
        <tr><td colspan="6" class="px-4 py-10 text-center text-sm text-gray-400">No audit records match the filters.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{% if result.pages > 1 %}
<div class="flex items-center justify-between mt-4 text-sm text-gray-600">
    <div>Page {{ result.page }} of {{ result.pages }} ({{ result.total }} records)</div>
    <div class="flex gap-1">
        {% for p in [result.page - 1, result.page, result.page + 1] %}
            {% if p >= 1 and p <= result.pages %}
            <a href="?{{ app.request.query.all|merge({page: p})|url_encode }}"
               class="px-3 py-1 rounded {{ p == result.page ? 'bg-brand-600 text-white' : 'bg-white border border-gray-300 hover:bg-gray-50' }}">{{ p }}</a>
            {% endif %}
        {% endfor %}
    </div>
</div>
{% endif %}
{% endblock %}
