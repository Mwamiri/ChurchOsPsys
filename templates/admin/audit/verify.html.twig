{% extends 'base.html.twig' %}
{% block title %}Audit trail integrity{% endblock %}
{% block page_title %}Audit trail integrity check{% endblock %}
{% set church_name = null %}

{% block content %}
{% if broken|length == 0 %}
<div class="bg-green-50 border border-green-200 rounded-xl p-6 text-center">
    <svg class="w-10 h-10 text-green-500 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    <p class="text-green-800 font-semibold">Chain is intact</p>
    <p class="text-green-600 text-sm mt-1">All {{ result.rows|length }} records verified on this page. No tampering detected.</p>
</div>
{% else %}
<div class="bg-red-50 border border-red-200 rounded-xl p-6 mb-4">
    <svg class="w-8 h-8 text-red-500 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
    <p class="text-red-800 font-bold">Chain broken — {{ broken|length }} record(s) with hash mismatch</p>
    <p class="text-red-600 text-sm mt-1">Record IDs: {{ broken|join(', ') }}</p>
</div>
{% endif %}

<div class="bg-white rounded-xl border border-gray-200 overflow-hidden mt-4">
    <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
                <th class="text-left px-4 py-3 text-xs font-semibold text-gray-600 uppercase">ID</th>
                <th class="text-left px-4 py-3 text-xs font-semibold text-gray-600 uppercase">When</th>
                <th class="text-left px-4 py-3 text-xs font-semibold text-gray-600 uppercase">Action</th>
                <th class="text-left px-4 py-3 text-xs font-semibold text-gray-600 uppercase">Hash (first 12)</th>
                <th class="text-left px-4 py-3 text-xs font-semibold text-gray-600 uppercase">Status</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
        {% for log in result.rows %}
        <tr class="{{ log.id in broken ? 'bg-red-50' : 'hover:bg-gray-50' }}">
            <td class="px-4 py-2 text-gray-500">{{ log.id }}</td>
            <td class="px-4 py-2 text-xs">{{ log.createdAt ? log.createdAt|date('d M Y H:i') : '—' }}</td>
            <td class="px-4 py-2">{{ log.action }}</td>
            <td class="px-4 py-2 font-mono text-xs">{{ log.hash ? log.hash|slice(0,12) ~ '…' : '—' }}</td>
            <td class="px-4 py-2">
                {% if log.id in broken %}
                    <span class="px-2 py-0.5 bg-red-100 text-red-700 rounded text-xs font-medium">BROKEN</span>
                {% else %}
                    <span class="px-2 py-0.5 bg-green-100 text-green-700 rounded text-xs font-medium">OK</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
<a href="{{ path('admin_audit_index') }}" class="mt-4 inline-block text-sm text-brand-600 hover:underline">← Back to audit trail</a>
{% endblock %}
