{% extends 'base.html.twig' %}
{% block title %}{{ is_new ? 'New centre' : 'Edit ' ~ centre.name }}{% endblock %}
{% block page_title %}{{ is_new ? 'New centre' : 'Edit ' ~ centre.name }}{% endblock %}
{% set church_name = null %}

{% block content %}
<div class="max-w-xl">
    <div class="bg-white rounded-xl border border-gray-200 p-6">
        {{ form_start(form, {attr: {class: 'space-y-4'}}) }}
        {% for field in form %}
        <div>
            {{ form_label(field, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(field, {attr: {class: 'w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500'}}) }}
            {{ form_errors(field) }}
        </div>
        {% endfor %}
        <div class="flex gap-3 pt-2">
            <button type="submit" class="px-5 py-2.5 bg-brand-600 text-white rounded-lg text-sm font-medium hover:bg-brand-700">{{ is_new ? 'Create centre' : 'Save' }}</button>
            <a href="{{ path('admin_centres_index') }}" class="px-4 py-2.5 text-sm text-gray-600 hover:text-gray-800">Cancel</a>
        </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
