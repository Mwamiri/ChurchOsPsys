{% extends 'base.html.twig' %}
{% block title %}Settings — {{ group|capitalize }}{% endblock %}
{% block page_title %}Settings{% endblock %}
{% set church_name = null %}

{% block content %}
<div class="flex gap-6">
    <!-- Sidebar nav -->
    <div class="w-40 flex-shrink-0">
        <nav class="space-y-0.5">
        {% for g in groups %}
            <a href="{{ path('admin_settings_index', {group: g}) }}"
               class="block px-3 py-2 rounded-lg text-sm {{ g == group ? 'bg-brand-50 text-brand-700 font-medium' : 'text-gray-600 hover:bg-gray-50' }}">
                {{ g|capitalize|replace({'_': ' '}) }}
            </a>
        {% endfor %}
        </nav>
    </div>

    <!-- Form -->
    <div class="flex-1 max-w-xl">
        <div class="bg-white rounded-xl border border-gray-200 p-6">
            <h2 class="text-base font-semibold text-gray-800 mb-5 capitalize">{{ group|replace({'_': ' '}) }} settings</h2>

            <form method="post" class="space-y-4">
                <input type="hidden" name="_token" value="{{ csrf_token('settings_' ~ group) }}">
                {% for key, def in fields %}
                <div>
                    <label for="s_{{ key }}" class="block text-sm font-medium text-gray-700 mb-1">{{ def.label }}</label>
                    {% if def.type == 'checkbox' %}
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="checkbox" id="s_{{ key }}" name="{{ key }}"
                                   class="rounded border-gray-300 text-brand-600"
                                   {{ current[key] == '1' ? 'checked' }}>
                            <span class="text-sm text-gray-600">Enabled</span>
                        </label>
                    {% elseif def.type == 'select' %}
                        <select id="s_{{ key }}" name="{{ key }}" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
                            {% for val, lbl in def.options %}
                            <option value="{{ val }}" {{ current[key] == val ? 'selected' }}>{{ lbl }}</option>
                            {% endfor %}
                        </select>
                    {% elseif def.type == 'textarea' %}
                        <textarea id="s_{{ key }}" name="{{ key }}" rows="3" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">{{ current[key] }}</textarea>
                    {% else %}
                        <input type="{{ def.type }}" id="s_{{ key }}" name="{{ key }}"
                               value="{{ current[key] ?? '' }}"
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"
                               {{ def.required ?? false ? 'required' : '' }}>
                    {% endif %}
                </div>
                {% endfor %}

                <div class="pt-2">
                    <button type="submit" class="px-5 py-2.5 bg-brand-600 text-white rounded-lg text-sm font-medium hover:bg-brand-700">Save settings</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
