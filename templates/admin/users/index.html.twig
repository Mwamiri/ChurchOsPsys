{% extends 'base.html.twig' %}
{% block title %}Users{% endblock %}
{% block page_title %}Users{% endblock %}
{% set church_name = null %}

{% block topbar_actions %}
{% if is_granted('ROLE_ADMIN') %}
<a href="{{ path('admin_users_new') }}" class="inline-flex items-center gap-1.5 px-3 py-2 bg-brand-600 text-white hover:bg-brand-700 rounded-lg text-sm font-medium">
    + New user
</a>
{% endif %}
{% endblock %}

{% block content %}
<!-- Filters -->
<form method="get" class="flex flex-wrap gap-3 mb-5 bg-white rounded-xl border border-gray-200 p-4">
    <input name="q" value="{{ q }}" type="search" placeholder="Search name / username / email…"
           class="flex-1 min-w-[180px] rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
    <select name="role" class="rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
        <option value="">All roles</option>
        {% for value, label in roles %}
        <option value="{{ value }}" {{ role == value ? 'selected' }}>{{ label }}</option>
        {% endfor %}
    </select>
    {% if is_granted('ROLE_ADMIN') %}
    <select name="centre" class="rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
        <option value="">All centres</option>
        {% for id, name in centres %}
        <option value="{{ id }}" {{ centre == id ? 'selected' }}>{{ name }}</option>
        {% endfor %}
    </select>
    {% endif %}
    <button type="submit" class="px-4 py-2 bg-brand-600 text-white rounded-lg text-sm font-medium hover:bg-brand-700">Search</button>
</form>

<!-- Table -->
<div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
                <th class="text-left px-4 py-3 text-xs font-semibold text-gray-600 uppercase tracking-wide">Name</th>
                <th class="text-left px-4 py-3 text-xs font-semibold text-gray-600 uppercase tracking-wide hidden sm:table-cell">Username</th>
                <th class="text-left px-4 py-3 text-xs font-semibold text-gray-600 uppercase tracking-wide hidden md:table-cell">Centre</th>
                <th class="text-left px-4 py-3 text-xs font-semibold text-gray-600 uppercase tracking-wide">Role</th>
                <th class="text-left px-4 py-3 text-xs font-semibold text-gray-600 uppercase tracking-wide hidden sm:table-cell">Status</th>
                <th class="px-4 py-3"></th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
        {% for user in result.rows %}
            <tr class="hover:bg-gray-50">
                <td class="px-4 py-3">
                    <div class="font-medium text-gray-900">{{ user.name }}</div>
                    {% if user.email %}<div class="text-xs text-gray-500">{{ user.email }}</div>{% endif %}
                </td>
                <td class="px-4 py-3 text-gray-600 hidden sm:table-cell">{{ user.username }}</td>
                <td class="px-4 py-3 text-gray-600 hidden md:table-cell">{{ user.centre ? user.centre.name : '—' }}</td>
                <td class="px-4 py-3">
                    <span class="inline-block px-2 py-0.5 rounded text-xs font-medium
                        {{ user.role in ['sysadmin','admin'] ? 'bg-red-100 text-red-700' : '' }}
                        {{ user.role == 'executive' ? 'bg-amber-100 text-amber-700' : '' }}
                        {{ user.role == 'centre_admin' ? 'bg-brand-100 text-brand-700' : '' }}
                        {{ user.role in ['clerk','volunteer','viewer'] ? 'bg-gray-100 text-gray-700' : '' }}">
                        {{ user.roleLabel }}
                    </span>
                </td>
                <td class="px-4 py-3 hidden sm:table-cell">
                    <span class="inline-block px-2 py-0.5 rounded text-xs font-medium {{ user.active ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500' }}">
                        {{ user.active ? 'Active' : 'Inactive' }}
                    </span>
                </td>
                <td class="px-4 py-3 text-right">
                    <div class="flex items-center justify-end gap-2" x-data>
                        <a href="{{ path('admin_users_edit', {id: user.id}) }}" class="text-xs text-brand-600 hover:text-brand-700 font-medium">Edit</a>
                        <form method="post" action="{{ path('admin_users_toggle', {id: user.id}) }}" class="inline" @submit="return confirm('Toggle active status?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle_user_' ~ user.id) }}">
                            <button type="submit" class="text-xs text-gray-500 hover:text-gray-700">{{ user.active ? 'Deactivate' : 'Activate' }}</button>
                        </form>
                        <form method="post" action="{{ path('admin_users_delete', {id: user.id}) }}" class="inline" @submit="return confirm('Delete this user? This cannot be undone.')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ user.id) }}">
                            <button type="submit" class="text-xs text-red-500 hover:text-red-700">Delete</button>
                        </form>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="6" class="px-4 py-10 text-center text-sm text-gray-400">No users found.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>

<!-- Pagination -->
{% if result.pages > 1 %}
<div class="flex items-center justify-between mt-4 text-sm text-gray-600">
    <div>Showing page {{ result.page }} of {{ result.pages }} ({{ result.total }} total)</div>
    <div class="flex gap-1">
        {% for p in 1..result.pages %}
        <a href="?{{ app.request.query.all|merge({page: p})|url_encode }}"
           class="px-3 py-1 rounded {{ p == result.page ? 'bg-brand-600 text-white' : 'bg-white border border-gray-300 hover:bg-gray-50' }}">{{ p }}</a>
        {% endfor %}
    </div>
</div>
{% endif %}
{% endblock %}
