{% extends 'base.html.twig' %}
{% block title %}Service Report — ChurchOS{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto">
  <div class="flex items-center gap-3 mb-6">
    <a href="{{ path('attendance_home') }}" class="text-gray-400 hover:text-gray-600">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    </a>
    <div>
      <h1 class="text-2xl font-bold text-gray-800">Service Report</h1>
      <p class="text-sm text-gray-500">{{ report.service_date|date('D, d M Y') }} — {{ report.service_type }}</p>
    </div>
    <div class="ml-auto flex gap-2">
      {% if report.status != 'approved' and is_granted('ROLE_CLERK') %}
      <a href="{{ path('attendance_edit', {id: report.id}) }}" class="btn-secondary text-sm">Edit</a>
      {% endif %}
      {% if report.status == 'draft' and is_granted('ROLE_CLERK') %}
      <form method="post" action="{{ path('attendance_submit', {id: report.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('submit_' ~ report.id) }}">
        <button class="btn-primary text-sm">Submit for Approval</button>
      </form>
      {% endif %}
      {% if report.status == 'submitted' and is_granted('ROLE_EXECUTIVE') %}
      <form method="post" action="{{ path('attendance_approve', {id: report.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('approve_' ~ report.id) }}">
        <button class="btn-primary text-sm bg-green-600 hover:bg-green-700">Approve</button>
      </form>
      {% endif %}
    </div>
  </div>

  <div class="grid grid-cols-3 gap-4 mb-6">
    <div class="card p-4 text-center">
      <p class="text-3xl font-bold text-blue-600">{{ report.attendance_total }}</p>
      <p class="text-xs text-gray-500 mt-1">Total Attendance</p>
      <p class="text-xs text-gray-400">{{ report.attendance_adults }}A / {{ report.attendance_youth }}Y / {{ report.attendance_children }}C</p>
    </div>
    <div class="card p-4 text-center">
      <p class="text-3xl font-bold text-orange-600">{{ report.first_timers }}</p>
      <p class="text-xs text-gray-500 mt-1">First Timers</p>
    </div>
    <div class="card p-4 text-center">
      <p class="text-3xl font-bold text-green-600">{{ report.offering_total|number_format(0) }}</p>
      <p class="text-xs text-gray-500 mt-1">Offering (KES)</p>
    </div>
  </div>

  <div class="card p-6">
    <dl class="grid grid-cols-2 gap-4">
      <div><dt class="text-xs text-gray-500 uppercase">New Believers</dt><dd class="mt-1 font-semibold">{{ report.new_believers }}</dd></div>
      <div><dt class="text-xs text-gray-500 uppercase">Preacher</dt><dd class="mt-1">{{ report.preacher ?? '—' }}</dd></div>
      <div class="col-span-2"><dt class="text-xs text-gray-500 uppercase">Sermon Title</dt><dd class="mt-1">{{ report.sermon_title ?? '—' }}</dd></div>
      <div><dt class="text-xs text-gray-500 uppercase">Scripture</dt><dd class="mt-1">{{ report.sermon_scripture ?? '—' }}</dd></div>
      <div><dt class="text-xs text-gray-500 uppercase">Status</dt>
        <dd class="mt-1">
          <span class="px-2 py-0.5 rounded-full text-xs font-medium
            {{ report.status == 'approved' ? 'bg-green-100 text-green-700' : (report.status == 'submitted' ? 'bg-yellow-100 text-yellow-700' : 'bg-gray-100 text-gray-600') }}">
            {{ report.status|capitalize }}
          </span>
        </dd>
      </div>
      {% if report.notes %}
      <div class="col-span-2"><dt class="text-xs text-gray-500 uppercase">Notes</dt><dd class="mt-1 text-sm whitespace-pre-line">{{ report.notes }}</dd></div>
      {% endif %}
    </dl>
  </div>
</div>
{% endblock %}
