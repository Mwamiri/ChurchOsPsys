{% block body_scripts %}{% endblock %}

<script>
/* ── Theme / contrast / text-size controls ── */
function setTextSize(s){
    document.documentElement.style.fontSize = s;
    try{localStorage.setItem('chosTextSize', s);}catch(e){}
}
document.getElementById('theme-toggle')?.addEventListener('click',function(){
    var h = document.documentElement;
    var dark = h.classList.toggle('dark');
    try{localStorage.setItem('chosTheme', dark ? 'dark' : 'light');}catch(e){}
});
document.getElementById('contrast-toggle')?.addEventListener('click',function(){
    var h = document.documentElement;
    var on = h.dataset.contrast === 'high';
    h.dataset.contrast = on ? '' : 'high';
    try{localStorage.setItem('chosContrast', on ? '' : 'high');}catch(e){}
});

/* ── Ctrl+K → focus search ── */
document.addEventListener('keydown',function(e){
    if((e.ctrlKey||e.metaKey) && e.key === 'k'){
        e.preventDefault();
        var s = document.getElementById('global-search');
        if(s){s.focus();s.select();}
    }
});

/* ── Offline banner ── */
var ob = document.getElementById('offline-banner');
if(ob){
    window.addEventListener('offline',function(){ob.classList.remove('hidden');});
    window.addEventListener('online',function(){ob.classList.add('hidden');});
}
</script>
</body>
</html>
