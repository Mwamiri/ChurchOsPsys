<!DOCTYPE html>
<html lang="en" x-data="{ sidebarOpen: window.innerWidth >= 1024 }">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}ChurchOS{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2220%22 fill=%22%232563eb%22/><text y=%22.9em%22 x=%22.1em%22 font-size=%2272%22>⛪</text></svg>">
    <script src="https://cdn.tailwindcss.com/3.4.1"></script>
    <script>tailwind.config={theme:{extend:{colors:{brand:{'50':'#eff6ff','100':'#dbeafe','200':'#bfdbfe','300':'#93c5fd','400':'#60a5fa','500':'#3b82f6','600':'#2563eb','700':'#1d4ed8','800':'#1e40af','900':'#1e3a8a'}}}}}</script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js"></script>
    <style>
    [x-cloak]{display:none!important}
    .card{background:#fff;border-radius:0.75rem;box-shadow:0 1px 3px 0 rgba(0,0,0,.08),0 1px 2px -1px rgba(0,0,0,.06)}
    .btn-primary{display:inline-flex;align-items:center;gap:0.375rem;padding:0.5rem 1rem;border-radius:0.5rem;font-size:0.875rem;font-weight:500;background:#2563eb;color:#fff;cursor:pointer;border:none;transition:background 150ms}
    .btn-primary:hover{background:#1d4ed8}
    .btn-secondary{display:inline-flex;align-items:center;gap:0.375rem;padding:0.5rem 1rem;border-radius:0.5rem;font-size:0.875rem;font-weight:500;background:#f3f4f6;color:#374151;border:1px solid #e5e7eb;cursor:pointer;transition:background 150ms}
    .btn-secondary:hover{background:#e5e7eb}
    .btn-ghost{display:inline-flex;align-items:center;gap:0.375rem;padding:0.5rem 1rem;border-radius:0.5rem;font-size:0.875rem;font-weight:500;color:#6b7280;cursor:pointer;transition:color 150ms}
    .btn-ghost:hover{color:#111827;background:#f9fafb}
    .btn-danger{display:inline-flex;align-items:center;gap:0.375rem;padding:0.5rem 1rem;border-radius:0.5rem;font-size:0.875rem;font-weight:500;background:#ef4444;color:#fff;cursor:pointer;border:none;transition:background 150ms}
    .btn-danger:hover{background:#dc2626}
    .input-field{width:100%;border:1px solid #d1d5db;border-radius:0.5rem;padding:0.5rem 0.75rem;font-size:0.875rem;line-height:1.25rem;color:#111827;outline:none;transition:border-color 150ms,box-shadow 150ms}
    .input-field:focus{border-color:#3b82f6;box-shadow:0 0 0 3px rgba(59,130,246,.15)}
    textarea.input-field{resize:vertical}
    .form-label{display:block;font-size:0.875rem;font-weight:500;color:#374151;margin-bottom:0.25rem}
    .line-clamp-2{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    </style>
    {% block head_extra %}{% endblock %}
</head>
<body class="bg-gray-50 text-gray-900 min-h-screen antialiased">

{% if app.user %}
<div class="flex h-screen overflow-hidden">
    <!-- Sidebar -->
    <aside class="fixed inset-y-0 left-0 z-50 w-64 bg-brand-900 text-white flex flex-col transition-transform duration-200 lg:static lg:translate-x-0"
           :class="sidebarOpen ? 'translate-x-0' : '-translate-x-full'">
        <div class="flex items-center gap-3 px-5 py-4 border-b border-brand-800">
            <div class="w-8 h-8 rounded-lg bg-brand-500 flex items-center justify-center font-bold text-sm">C</div>
            <div>
                <div class="text-sm font-semibold leading-tight">{{ church_name ?? 'ChurchOS' }}</div>
                <div class="text-xs text-brand-300">P Edition</div>
            </div>
        </div>

        <nav class="flex-1 px-3 py-4 space-y-0.5 overflow-y-auto text-sm">
            <a href="{{ path('insights_dashboard') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg {{ app.request.pathInfo == '/dashboard' ? 'bg-brand-700 text-white' : 'text-brand-200 hover:bg-brand-800 hover:text-white' }}">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                Dashboard
            </a>

            <div class="pt-4">
                <p class="px-3 pb-1 text-[10px] font-semibold text-brand-400 uppercase tracking-widest">Insights</p>
                <a href="{{ path('insights_reports_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg {{ '/reports' in app.request.pathInfo ? 'bg-brand-700 text-white' : 'text-brand-200 hover:bg-brand-800 hover:text-white' }}">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    Reports
                </a>
            </div>

            {# ── Ministry / CRM ─────────────────────────────── #}
            <div class="pt-4" x-data="{ open: {{ '/ministry' in app.request.pathInfo ? 'true' : 'false' }} }">
                <button @click="open=!open" class="w-full flex items-center justify-between px-3 py-2 text-brand-200 hover:text-white text-[10px] font-semibold uppercase tracking-widest">
                    Ministry
                    <svg class="w-3 h-3 transition-transform" :class="open?'rotate-180':''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </button>
                <div x-show="open" x-cloak class="space-y-0.5">
                    {% for area, areaCfg in {members:'Members',leaders:'Leaders',new_believers:'New Believers',visitors:'Visitors',households:'Households',groups:'Groups',partners:'Partners',missions:'Missions',diaspora:'Diaspora',business_forum:'Business Forum',church_assets:'Assets'} %}
                    <a href="{{ path('ministry_list', {area: area}) }}"
                       class="flex items-center gap-3 pl-6 pr-3 py-1.5 rounded-lg text-xs {{ ('/ministry/'~area) in app.request.pathInfo ? 'bg-brand-700 text-white' : 'text-brand-300 hover:bg-brand-800 hover:text-white' }}">
                        {{ areaCfg }}
                    </a>
                    {% endfor %}
                </div>
            </div>

            {# ── Operations ─────────────────────────────────── #}
            <div class="pt-3">
                <p class="px-3 pb-1 text-[10px] font-semibold text-brand-400 uppercase tracking-widest">Operations</p>
                <a href="{{ path('attendance_home') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg {{ '/attendance' in app.request.pathInfo ? 'bg-brand-700 text-white' : 'text-brand-200 hover:bg-brand-800 hover:text-white' }}">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2l-3 9H9l-3-9z"/></svg>
                    Attendance
                </a>
                <a href="{{ path('giving_home') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg {{ '/giving' in app.request.pathInfo ? 'bg-brand-700 text-white' : 'text-brand-200 hover:bg-brand-800 hover:text-white' }}">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                    Giving
                </a>
                <a href="{{ path('people_groups') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg {{ '/people' in app.request.pathInfo ? 'bg-brand-700 text-white' : 'text-brand-200 hover:bg-brand-800 hover:text-white' }}">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    Groups & People
                </a>
                <a href="{{ path('announcements_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg {{ '/announcements' in app.request.pathInfo ? 'bg-brand-700 text-white' : 'text-brand-200 hover:bg-brand-800 hover:text-white' }}">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/></svg>
                    Announcements
                </a>
                <a href="{{ path('calendar_home') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg {{ '/calendar' in app.request.pathInfo ? 'bg-brand-700 text-white' : 'text-brand-200 hover:bg-brand-800 hover:text-white' }}">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    Calendar
                </a>
                {% if is_granted('ROLE_CLERK') %}
                <a href="{{ path('sms_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg {{ '/sms' in app.request.pathInfo ? 'bg-brand-700 text-white' : 'text-brand-200 hover:bg-brand-800 hover:text-white' }}">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
                    SMS
                </a>
                <a href="{{ path('forms_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg {{ '/admin/forms' in app.request.pathInfo ? 'bg-brand-700 text-white' : 'text-brand-200 hover:bg-brand-800 hover:text-white' }}">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    Forms
                </a>
                {% endif %}
            </div>

            {# ── Administration ─────────────────────────── #}
            {% if is_granted('ROLE_CENTRE_ADMIN') %}
            <div class="pt-3">
                <p class="px-3 pb-1 text-[10px] font-semibold text-brand-400 uppercase tracking-widest">Administration</p>
                <a href="{{ path('admin_users_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg {{ '/admin/users' in app.request.pathInfo ? 'bg-brand-700 text-white' : 'text-brand-200 hover:bg-brand-800 hover:text-white' }}">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                    Users
                </a>
                {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('admin_centres_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg {{ '/admin/centres' in app.request.pathInfo ? 'bg-brand-700 text-white' : 'text-brand-200 hover:bg-brand-800 hover:text-white' }}">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                    Centres
                </a>
                <a href="{{ path('admin_settings_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg {{ '/admin/settings' in app.request.pathInfo ? 'bg-brand-700 text-white' : 'text-brand-200 hover:bg-brand-800 hover:text-white' }}">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    Settings
                </a>
                <a href="{{ path('admin_audit_index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg {{ '/admin/audit' in app.request.pathInfo ? 'bg-brand-700 text-white' : 'text-brand-200 hover:bg-brand-800 hover:text-white' }}">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                    Audit trail
                </a>
                {% endif %}
            </div>
            {% endif %}
        </nav>

        <div class="px-4 py-3 border-t border-brand-800">
            <a href="{{ path('profile_index') }}" class="block hover:bg-brand-800 rounded-lg p-1 -mx-1">
                <div class="text-sm font-medium">{{ app.user.name }}</div>
                <div class="text-xs text-brand-400">{{ app.user.roleLabel }}</div>
            </a>
            <a href="{{ path('app_logout') }}" class="mt-1 text-xs text-brand-400 hover:text-white">Sign out →</a>
        </div>
    </aside>

    <!-- Main content area -->
    <div class="flex-1 flex flex-col min-w-0 overflow-auto">
        <header class="bg-white border-b border-gray-200 px-4 py-3 flex items-center gap-3 sticky top-0 z-40">
            <button @click="sidebarOpen = !sidebarOpen" class="lg:hidden p-2 rounded text-gray-500 hover:bg-gray-100">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>
            <h1 class="flex-1 text-base font-semibold text-gray-800">{% block page_title '' %}</h1>
            {% block topbar_actions %}{% endblock %}
        </header>

        <div class="px-6 pt-4 space-y-2">
            {% for type, messages in app.flashes(['success','error','warning','info']) %}
                {% for msg in messages %}
                    <div x-data x-init="setTimeout(()=>$el.remove(),5000)"
                         class="rounded-lg px-4 py-3 text-sm font-medium border
                         {{ type == 'success' ? 'bg-green-50 text-green-800 border-green-200' }}
                         {{ type == 'error'   ? 'bg-red-50   text-red-800   border-red-200' }}
                         {{ type == 'warning' ? 'bg-yellow-50 text-yellow-800 border-yellow-200' }}
                         {{ type == 'info'    ? 'bg-blue-50  text-blue-800  border-blue-200' }}">{{ msg }}</div>
                {% endfor %}
            {% endfor %}
        </div>

        <main class="flex-1 px-6 py-4">
{% endif %}

{# ── Each block defined exactly ONCE ── #}
{% block content %}{% block body %}{% endblock %}{% endblock %}

{% if app.user %}
        </main>
        <footer class="text-center text-xs text-gray-400 py-3 border-t border-gray-100">
            ChurchOS P Edition · Symfony · &copy; {{ 'now'|date('Y') }} Mwamiri Computers Ltd
        </footer>
    </div>
</div>
<div x-show="sidebarOpen" x-cloak @click="sidebarOpen=false" class="fixed inset-0 bg-black/50 z-40 lg:hidden"></div>
{% endif %}

{% block body_scripts %}{% endblock %}
</body>
</html>
