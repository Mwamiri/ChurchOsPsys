{% extends 'base.html.twig' %}
{% block title %}{{ isNew ? 'New' : 'Edit' }} Event — ChurchOS{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto">
  <div class="flex items-center gap-3 mb-6">
    <a href="{{ path('calendar_home') }}" class="text-gray-400 hover:text-gray-600">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    </a>
    <h1 class="text-2xl font-bold text-gray-800">{{ isNew ? 'New Event' : 'Edit Event' }}</h1>
  </div>

  <form method="post" class="card p-6 space-y-4">
    <div>
      <label class="form-label">Event Title <span class="text-red-500">*</span></label>
      <input type="text" name="title" value="{{ event.title ?? '' }}" required class="input-field">
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="form-label">Start Date <span class="text-red-500">*</span></label>
        <input type="date" name="start_date" value="{{ event.start_date ?? '' }}" required class="input-field">
      </div>
      <div>
        <label class="form-label">End Date</label>
        <input type="date" name="end_date" value="{{ event.end_date ?? '' }}" class="input-field">
      </div>
      <div>
        <label class="form-label">Start Time</label>
        <input type="time" name="start_time" value="{{ event.start_time ?? '' }}" class="input-field">
      </div>
      <div>
        <label class="form-label">End Time</label>
        <input type="time" name="end_time" value="{{ event.end_time ?? '' }}" class="input-field">
      </div>
    </div>
    <div>
      <label class="form-label">Location</label>
      <input type="text" name="location" value="{{ event.location ?? '' }}" class="input-field">
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="form-label">Category</label>
        <select name="category" class="input-field">
          {% for c in ['worship','prayer','fellowship','outreach','training','meeting','other'] %}
          <option value="{{ c }}" {{ event.category == c ? 'selected' : '' }}>{{ c|capitalize }}</option>
          {% endfor %}
        </select>
      </div>
      <div>
        <label class="form-label">Color</label>
        <input type="color" name="color" value="{{ event.color ?? '#3b82f6' }}" class="h-10 w-full border border-gray-300 rounded-lg px-1">
      </div>
    </div>
    <div>
      <label class="form-label">Description</label>
      <textarea name="description" rows="3" class="input-field">{{ event.description ?? '' }}</textarea>
    </div>
    <div class="flex items-center gap-2">
      <input type="checkbox" name="all_day" id="allDay" value="1" {{ event.all_day ? 'checked' : '' }} class="w-4 h-4 text-blue-600 rounded">
      <label for="allDay" class="text-sm text-gray-700">All-day event</label>
    </div>
    <div class="flex justify-between pt-2 border-t border-gray-100">
      <a href="{{ path('calendar_home') }}" class="btn-ghost">Cancel</a>
      {% if not isNew %}
      <form method="post" action="{{ path('calendar_event_delete', {id: event.id}) }}" class="inline" onsubmit="return confirm('Delete this event?')">
        <input type="hidden" name="_token" value="{{ csrf_token('del_cal_' ~ event.id) }}">
        <button class="btn-danger text-sm">Delete</button>
      </form>
      {% endif %}
      <button type="submit" class="btn-primary">{{ isNew ? 'Create Event' : 'Update Event' }}</button>
    </div>
  </form>
</div>
{% endblock %}
