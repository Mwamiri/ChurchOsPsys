{% extends 'base.html.twig' %}
{% block title %}{{ event.title }} — Calendar — ChurchOS{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto">
  <div class="flex items-center gap-3 mb-6">
    <a href="{{ path('calendar_home') }}" class="text-gray-400 hover:text-gray-600">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    </a>
    <h1 class="text-2xl font-bold text-gray-800">{{ event.title }}</h1>
    {% if is_granted('ROLE_CLERK') %}
    <a href="{{ path('calendar_event_edit', {id: event.id}) }}" class="ml-auto btn-secondary text-sm">Edit</a>
    {% endif %}
  </div>

  <div class="card p-6 space-y-4">
    <div class="grid grid-cols-2 gap-4">
      <div>
        <p class="text-xs text-gray-400 uppercase tracking-wide mb-1">Start</p>
        <p class="text-sm font-medium">{{ event.start_date|date('D, d M Y') }}
          {% if event.start_time %} at {{ event.start_time|date('H:i') }}{% endif %}
        </p>
      </div>
      {% if event.end_date %}
      <div>
        <p class="text-xs text-gray-400 uppercase tracking-wide mb-1">End</p>
        <p class="text-sm font-medium">{{ event.end_date|date('D, d M Y') }}
          {% if event.end_time %} at {{ event.end_time|date('H:i') }}{% endif %}
        </p>
      </div>
      {% endif %}
    </div>

    {% if event.location %}
    <div>
      <p class="text-xs text-gray-400 uppercase tracking-wide mb-1">Location</p>
      <p class="text-sm">{{ event.location }}</p>
    </div>
    {% endif %}

    {% if event.event_type %}
    <div>
      <p class="text-xs text-gray-400 uppercase tracking-wide mb-1">Type</p>
      <span class="inline-block px-2 py-0.5 bg-blue-50 text-blue-700 text-xs rounded-full">
        {{ event.event_type|replace({'_':' '})|capitalize }}
      </span>
    </div>
    {% endif %}

    {% if event.description %}
    <div>
      <p class="text-xs text-gray-400 uppercase tracking-wide mb-1">Description</p>
      <p class="text-sm text-gray-700 whitespace-pre-line">{{ event.description }}</p>
    </div>
    {% endif %}

    {% if event.recurrence and event.recurrence != 'none' %}
    <div>
      <p class="text-xs text-gray-400 uppercase tracking-wide mb-1">Recurrence</p>
      <p class="text-sm">{{ event.recurrence|capitalize }}</p>
    </div>
    {% endif %}

    <div class="pt-4 flex justify-between items-center border-t border-gray-100">
      {% if is_granted('ROLE_ADMIN') %}
      <form method="post" action="{{ path('calendar_event_delete', {id: event.id}) }}" onsubmit="return confirm('Delete this event?')">
        <button type="submit" class="btn-danger text-sm">Delete</button>
      </form>
      {% else %}
      <span></span>
      {% endif %}
      <a href="{{ path('calendar_home') }}" class="btn-ghost text-sm">Back to Calendar</a>
    </div>
  </div>
</div>
{% endblock %}
