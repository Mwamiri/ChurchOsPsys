<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ form.title }}</title>
  <script src="https://cdn.tailwindcss.com/3.4.1"></script>
  <style>
  .input-field{width:100%;border:1px solid #d1d5db;border-radius:0.5rem;padding:0.5rem 0.75rem;font-size:0.875rem;outline:none}
  .input-field:focus{border-color:#3b82f6;box-shadow:0 0 0 3px rgba(59,130,246,.15)}
  .form-label{display:block;font-size:0.875rem;font-weight:500;color:#374151;margin-bottom:0.25rem}
  </style>
</head>
<body class="bg-gray-50 min-h-screen py-12">
<div class="max-w-lg mx-auto px-4">
  <div class="bg-white rounded-2xl shadow-md p-8">
    <div class="mb-8">
      <h1 class="text-2xl font-bold text-gray-800 mb-2">{{ form.title }}</h1>
      {% if form.description %}<p class="text-sm text-gray-500">{{ form.description }}</p>{% endif %}
    </div>

    {% if not form.is_active %}
    <div class="rounded-lg bg-yellow-50 border border-yellow-200 px-4 py-3 text-sm text-yellow-800">
      This form is currently closed and not accepting responses.
    </div>
    {% else %}
    <form method="post" class="space-y-5">
      {% set fields = form.fields|json_decode ?? [] %}
      {% for fld in fields %}
      <div>
        <label class="form-label">
          {{ fld.label }}{% if fld.required %} <span class="text-red-500">*</span>{% endif %}
        </label>
        {% if fld.type == 'textarea' %}
          <textarea name="fields[{{ fld.label }}]" rows="3" {{ fld.required ? 'required' : '' }}
            class="input-field resize-y"></textarea>
        {% elseif fld.type == 'select' %}
          <select name="fields[{{ fld.label }}]" {{ fld.required ? 'required' : '' }} class="input-field">
            <option value="">— Select —</option>
            {% for opt in (fld.options ?? [])|split(',') %}
            <option value="{{ opt|trim }}">{{ opt|trim }}</option>
            {% endfor %}
          </select>
        {% elseif fld.type == 'checkbox' %}
          <div class="flex items-center gap-2 mt-1">
            <input type="checkbox" name="fields[{{ fld.label }}]" value="1" id="fld_{{ loop.index }}"
              class="w-4 h-4 rounded border-gray-300 text-blue-600">
            <label for="fld_{{ loop.index }}" class="text-sm text-gray-700">{{ fld.label }}</label>
          </div>
        {% else %}
          <input type="{{ fld.type }}" name="fields[{{ fld.label }}]" {{ fld.required ? 'required' : '' }}
            class="input-field">
        {% endif %}
      </div>
      {% endfor %}

      <div class="pt-2">
        <button type="submit" class="w-full py-3 px-6 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm transition-colors">
          Submit
        </button>
      </div>
    </form>
    {% endif %}
  </div>
  <p class="text-center text-xs text-gray-400 mt-6">Powered by ChurchOS</p>
</div>
</body>
</html>
