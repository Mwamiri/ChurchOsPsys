{% extends 'base.html.twig' %}
{% block title %}Batch {{ batch.batch_ref }} — ChurchOS{% endblock %}

{% block body %}
<div class="flex items-center gap-3 mb-6">
  <a href="{{ path('giving_batches') }}" class="text-gray-400 hover:text-gray-600">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
  </a>
  <div>
    <h1 class="text-2xl font-bold text-gray-800">Batch {{ batch.batch_ref }}</h1>
    <p class="text-sm text-gray-500">{{ batch.batch_date|date('D, d M Y') }} — {{ batch.description }}</p>
  </div>
  <div class="ml-auto flex items-center gap-3">
    <span class="px-3 py-1 rounded-full text-sm font-medium
      {{ batch.status == 'open' ? 'bg-blue-100 text-blue-700' : 'bg-green-100 text-green-700' }}">
      {{ batch.status|capitalize }}
    </span>
    {% if batch.status == 'open' and is_granted('ROLE_EXECUTIVE') %}
    <form method="post" action="{{ path('giving_batch_close', {id: batch.id}) }}">
      <input type="hidden" name="_token" value="{{ csrf_token('close_batch_' ~ batch.id) }}">
      <button class="btn-primary text-sm" onclick="return confirm('Close and approve this batch?')">Close Batch</button>
    </form>
    {% endif %}
  </div>
</div>

<div class="grid grid-cols-3 gap-4 mb-6">
  <div class="card p-4 text-center">
    <p class="text-2xl font-bold text-green-600">KES {{ batch.total_amount|number_format(2) }}</p>
    <p class="text-xs text-gray-500">Total Collected</p>
  </div>
  <div class="card p-4 text-center">
    <p class="text-2xl font-bold text-blue-600">{{ contributions|length }}</p>
    <p class="text-xs text-gray-500">Entries</p>
  </div>
  <div class="card p-4 text-center">
    <p class="text-2xl font-bold text-gray-600">{{ batch.status|capitalize }}</p>
    <p class="text-xs text-gray-500">Status</p>
  </div>
</div>

{% if batch.status == 'open' and is_granted('ROLE_CLERK') %}
<div class="card p-5 mb-6">
  <h2 class="text-base font-semibold text-gray-700 mb-3">Add Contribution</h2>
  <form method="post" action="{{ path('giving_contribution_add', {id: batch.id}) }}" class="grid grid-cols-2 md:grid-cols-4 gap-3">
    <input name="contributor_name" placeholder="Contributor Name" class="input-field">
    <select name="fund_id" class="input-field">
      <option value="">— Fund —</option>
      {% for f in funds %}<option value="{{ f.id }}">{{ f.name }}</option>{% endfor %}
    </select>
    <input name="amount" type="number" step="0.01" placeholder="Amount (KES)" required class="input-field">
    <select name="method" class="input-field">
      <option value="cash">Cash</option>
      <option value="mpesa">M-Pesa</option>
      <option value="cheque">Cheque</option>
      <option value="bank">Bank Transfer</option>
      <option value="card">Card</option>
    </select>
    <input name="reference" placeholder="Reference / Txn ID" class="input-field">
    <input name="notes" placeholder="Notes" class="input-field md:col-span-2">
    <div class="flex justify-end">
      <button type="submit" class="btn-primary w-full">Add</button>
    </div>
  </form>
</div>
{% endif %}

<div class="card overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200 text-sm">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-4 py-3 text-left font-medium text-gray-500">Contributor</th>
        <th class="px-4 py-3 text-left font-medium text-gray-500">Fund</th>
        <th class="px-4 py-3 text-right font-medium text-gray-500">Amount (KES)</th>
        <th class="px-4 py-3 text-left font-medium text-gray-500">Method</th>
        <th class="px-4 py-3 text-left font-medium text-gray-500">Reference</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      {% for c in contributions %}
      <tr>
        <td class="px-4 py-2.5">{{ c.contributor_name ?? 'Anonymous' }}</td>
        <td class="px-4 py-2.5 text-gray-500">{{ c.fund_name ?? 'General' }}</td>
        <td class="px-4 py-2.5 text-right font-medium">{{ c.amount|number_format(2) }}</td>
        <td class="px-4 py-2.5 text-gray-500">{{ c.method|capitalize }}</td>
        <td class="px-4 py-2.5 font-mono text-xs text-gray-400">{{ c.reference ?? '—' }}</td>
      </tr>
      {% else %}
      <tr><td colspan="5" class="px-4 py-8 text-center text-gray-400">No contributions yet.</td></tr>
      {% endfor %}
    </tbody>
    {% if contributions %}
    <tfoot class="bg-gray-50">
      <tr>
        <td colspan="2" class="px-4 py-3 font-semibold text-gray-700">Total</td>
        <td class="px-4 py-3 text-right font-bold text-green-700">
          KES {{ contributions|sum(c => c.amount)|number_format(2) }}
        </td>
        <td colspan="2"></td>
      </tr>
    </tfoot>
    {% endif %}
  </table>
</div>
{% endblock %}
