{% extends 'base.html.twig' %}
{% block title %}{{ isNew ? 'New' : 'Edit' }} Fund — ChurchOS{% endblock %}
{% block body %}
<div class="max-w-lg mx-auto">
  <div class="flex items-center gap-3 mb-6">
    <a href="{{ path('giving_funds') }}" class="text-gray-400 hover:text-gray-600">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    </a>
    <h1 class="text-2xl font-bold text-gray-800">{{ isNew ? 'New Fund' : 'Edit Fund' }}</h1>
  </div>
  <form method="post" class="card p-6 space-y-4">
    <div><label class="form-label">Fund Name <span class="text-red-500">*</span></label><input type="text" name="name" value="{{ fund.name ?? '' }}" required class="input-field"></div>
    <div><label class="form-label">Code</label><input type="text" name="code" value="{{ fund.code ?? '' }}" placeholder="e.g. TITHE" class="input-field"></div>
    <div><label class="form-label">Type</label>
      <select name="type" class="input-field">
        {% for t in ['general','tithe','offering','project','missions','welfare','other'] %}
        <option value="{{ t }}" {{ (fund.type ?? 'general') == t ? 'selected' : '' }}>{{ t|capitalize }}</option>
        {% endfor %}
      </select>
    </div>
    <div><label class="form-label">Target Amount (KES)</label><input type="number" step="0.01" name="target_amount" value="{{ fund.target_amount ?? '' }}" class="input-field"></div>
    <div><label class="form-label">Description</label><textarea name="description" rows="2" class="input-field">{{ fund.description ?? '' }}</textarea></div>
    <div class="flex justify-between pt-2 border-t border-gray-100">
      <a href="{{ path('giving_funds') }}" class="btn-ghost">Cancel</a>
      <button type="submit" class="btn-primary">{{ isNew ? 'Create Fund' : 'Update Fund' }}</button>
    </div>
  </form>
</div>
{% endblock %}
