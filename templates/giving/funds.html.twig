{% extends 'base.html.twig' %}
{% block title %}Funds — ChurchOS{% endblock %}

{% block body %}
<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-800">Funds</h1>
  {% if is_granted('ROLE_ADMIN') %}
  <a href="{{ path('giving_fund_new') }}" class="btn-primary text-sm">New Fund</a>
  {% endif %}
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
  {% for f in funds %}
  <div class="card p-5">
    <div class="flex items-center justify-between mb-2">
      <h2 class="font-semibold text-gray-800">{{ f.name }}</h2>
      {% if is_granted('ROLE_ADMIN') %}
      <a href="{{ path('giving_fund_edit', {id: f.id}) }}" class="text-gray-400 hover:text-gray-600 text-xs">Edit</a>
      {% endif %}
    </div>
    {% if f.code %}<p class="text-xs text-gray-400 font-mono mb-2">{{ f.code }}</p>{% endif %}
    <p class="text-2xl font-bold text-green-600">KES {{ f.balance|number_format(2) }}</p>
    {% if f.target_amount %}
    <div class="mt-2">
      <div class="flex justify-between text-xs text-gray-500 mb-1">
        <span>Progress</span><span>{{ f.target_amount|number_format(2) }}</span>
      </div>
      <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
        <div class="h-full bg-green-500 rounded-full" style="width:{{ [((f.balance / f.target_amount) * 100)|round(1), 100]|min }}%"></div>
      </div>
    </div>
    {% endif %}
    <div class="mt-2 flex items-center justify-between">
      <span class="text-xs px-2 py-0.5 rounded-full {{ f.type == 'tithe' ? 'bg-purple-100 text-purple-700' : 'bg-gray-100 text-gray-600' }}">{{ f.type|capitalize }}</span>
      <span class="text-xs {{ f.is_active ? 'text-green-600' : 'text-gray-400' }}">{{ f.is_active ? 'Active' : 'Inactive' }}</span>
    </div>
  </div>
  {% else %}
  <div class="col-span-3 card p-8 text-center text-gray-400">No funds created yet.</div>
  {% endfor %}
</div>
{% endblock %}
