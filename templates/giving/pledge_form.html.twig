{% extends 'base.html.twig' %}
{% block title %}New Pledge — ChurchOS{% endblock %}
{% block body %}
<div class="max-w-lg mx-auto">
  <div class="flex items-center gap-3 mb-6">
    <a href="{{ path('giving_pledges') }}" class="text-gray-400 hover:text-gray-600">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    </a>
    <h1 class="text-2xl font-bold text-gray-800">New Pledge</h1>
  </div>
  <form method="post" class="card p-6 space-y-4">
    <div><label class="form-label">Pledger Name <span class="text-red-500">*</span></label><input type="text" name="pledger_name" value="{{ pledge.pledger_name ?? '' }}" required class="input-field"></div>
    <div><label class="form-label">Phone</label><input type="tel" name="phone" value="{{ pledge.phone ?? '' }}" class="input-field"></div>
    <div><label class="form-label">Fund</label>
      <select name="fund_id" class="input-field">
        <option value="">— General —</option>
        {% for f in funds %}<option value="{{ f.id }}" {{ pledge.fund_id == f.id ? 'selected' : '' }}>{{ f.name }}</option>{% endfor %}
      </select>
    </div>
    <div><label class="form-label">Pledged Amount (KES) <span class="text-red-500">*</span></label><input type="number" step="0.01" name="pledged_amount" value="{{ pledge.pledged_amount ?? '' }}" required class="input-field"></div>
    <div class="grid grid-cols-2 gap-4">
      <div><label class="form-label">Pledge Date</label><input type="date" name="pledge_date" value="{{ pledge.pledge_date ?? 'now'|date('Y-m-d') }}" class="input-field"></div>
      <div><label class="form-label">Due Date</label><input type="date" name="due_date" value="{{ pledge.due_date ?? '' }}" class="input-field"></div>
    </div>
    <div><label class="form-label">Frequency</label>
      <select name="frequency" class="input-field">
        {% for f in ['once','weekly','monthly','quarterly','annually'] %}
        <option value="{{ f }}" {{ (pledge.frequency ?? 'once') == f ? 'selected' : '' }}>{{ f|capitalize }}</option>
        {% endfor %}
      </select>
    </div>
    <div><label class="form-label">Notes</label><textarea name="notes" rows="2" class="input-field">{{ pledge.notes ?? '' }}</textarea></div>
    <div class="flex justify-between pt-2 border-t border-gray-100">
      <a href="{{ path('giving_pledges') }}" class="btn-ghost">Cancel</a>
      <button type="submit" class="btn-primary">Record Pledge</button>
    </div>
  </form>
</div>
{% endblock %}
