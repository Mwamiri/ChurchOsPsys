{% extends 'base.html.twig' %}
{% block title %}Annual report {{ year }}{% endblock %}
{% block page_title %}Annual report — {{ year }}{% endblock %}

{% block topbar_actions %}
<form method="get" class="flex items-center gap-2">
    <select name="year" class="rounded-lg border border-gray-300 px-3 py-2 text-sm" onchange="this.form.submit()">
        {% for y in years %}<option value="{{ y }}" {{ y == year ? 'selected' }}>{{ y }}</option>{% endfor %}
    </select>
</form>
{% endblock %}

{% block content %}
<div class="space-y-4">
    <div class="bg-white rounded-xl border border-gray-200 p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-1">{{ church }} — Annual Report {{ year }}</h2>
        <p class="text-sm text-gray-500">Full-church summary for the calendar year.</p>
    </div>

    {% if data.attendance %}
    <div class="bg-white rounded-xl border border-gray-200 p-5">
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Attendance — {{ data.attendance|map(r => r.total)|sum|number_format }} total</h3>
        {% set maxAtt = data.attendance|map(r => r.total)|max %}
        <div class="flex items-end gap-1 h-20">
        {% for mo in 1..12 %}
            {% set row = data.attendance|filter(r => r.mo == mo)|first %}
            {% set h = row and maxAtt > 0 ? (row.total / maxAtt * 80)|round : 0 %}
            <div class="flex-1 flex flex-col items-center gap-0.5" title="{{ data.month_labels[mo-1] }}: {{ row ? row.total : 0 }}">
                <div class="w-full bg-brand-500 rounded-sm" style="height: {{ h > 0 ? h : 2 }}px"></div>
                <div class="text-[9px] text-gray-400">{{ data.month_labels[mo-1]|slice(0,1) }}</div>
            </div>
        {% endfor %}
        </div>
    </div>
    {% endif %}

    {% if data.giving %}
    <div class="bg-white rounded-xl border border-gray-200 p-5">
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Giving — KES {{ data.giving|map(r => r.total)|sum|number_format(2) }}</h3>
        {% set maxGiv = data.giving|map(r => r.total)|max %}
        <div class="flex items-end gap-1 h-20">
        {% for mo in 1..12 %}
            {% set row = data.giving|filter(r => r.mo == mo)|first %}
            {% set h = row and maxGiv > 0 ? (row.total / maxGiv * 80)|round : 0 %}
            <div class="flex-1 flex flex-col items-center gap-0.5" title="{{ data.month_labels[mo-1] }}: KES {{ row ? row.total|number_format(2) : 0 }}">
                <div class="w-full bg-emerald-500 rounded-sm" style="height: {{ h > 0 ? h : 2 }}px"></div>
                <div class="text-[9px] text-gray-400">{{ data.month_labels[mo-1]|slice(0,1) }}</div>
            </div>
        {% endfor %}
        </div>
    </div>
    {% endif %}

    {% if data.new_members %}
    <div class="bg-white rounded-xl border border-gray-200 p-5">
        <h3 class="text-sm font-semibold text-gray-700 mb-3">New members — {{ data.new_members|map(r => r.cnt)|sum|number_format }} total</h3>
        {% set maxNm = data.new_members|map(r => r.cnt)|max %}
        <div class="flex items-end gap-1 h-20">
        {% for mo in 1..12 %}
            {% set row = data.new_members|filter(r => r.mo == mo)|first %}
            {% set h = row and maxNm > 0 ? (row.cnt / maxNm * 80)|round : 0 %}
            <div class="flex-1 flex flex-col items-center gap-0.5">
                <div class="w-full bg-violet-500 rounded-sm" style="height: {{ h > 0 ? h : 2 }}px"></div>
                <div class="text-[9px] text-gray-400">{{ data.month_labels[mo-1]|slice(0,1) }}</div>
            </div>
        {% endfor %}
        </div>
    </div>
    {% endif %}
</div>
<a href="{{ path('insights_reports_index') }}" class="mt-4 inline-block text-sm text-brand-600 hover:underline">← All reports</a>
{% endblock %}
