{% extends 'base.html.twig' %}
{% block title %}Reports{% endblock %}
{% block page_title %}Reports{% endblock %}

{% block content %}
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {% macro report_card(title, desc, icon, route, color) %}
    <a href="{{ path(route) }}" class="bg-white rounded-xl border border-gray-200 p-5 hover:border-brand-300 hover:shadow-sm transition group">
        <div class="flex items-start gap-4">
            <div class="p-2.5 rounded-lg {{ color }}">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="{{ icon }}"/>
                </svg>
            </div>
            <div>
                <div class="font-semibold text-gray-900 group-hover:text-brand-700 transition">{{ title }}</div>
                <div class="text-sm text-gray-500 mt-0.5">{{ desc }}</div>
            </div>
        </div>
    </a>
    {% endmacro %}

    {{ _self.report_card(
        'Ministry report',
        'Attendance, new souls, missions by centre and month',
        'M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
        'insights_reports_ministry',
        'bg-brand-500'
    ) }}

    {{ _self.report_card(
        'Annual report',
        'Full-year summary across all modules',
        'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
        'insights_reports_annual',
        'bg-violet-500'
    ) }}

    {% if is_granted('ROLE_ADMIN') %}
    {{ _self.report_card(
        'Sign-in report',
        'Login history and failed attempts',
        'M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z',
        'insights_reports_signins',
        'bg-rose-500'
    ) }}
    {% endif %}
</div>
{% endblock %}
