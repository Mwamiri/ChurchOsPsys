{% extends 'base.html.twig' %}
{% block title %}Ministry report {{ year }}{% endblock %}
{% block page_title %}Ministry report — {{ year }}{% endblock %}

{% block topbar_actions %}
<form method="get" class="flex items-center gap-2">
    <select name="year" class="rounded-lg border border-gray-300 px-3 py-2 text-sm" onchange="this.form.submit()">
        {% for y in years %}<option value="{{ y }}" {{ y == year ? 'selected' }}>{{ y }}</option>{% endfor %}
    </select>
    <select name="centre" class="rounded-lg border border-gray-300 px-3 py-2 text-sm" onchange="this.form.submit()">
        <option value="">All centres</option>
        {% for id, name in centres %}<option value="{{ id }}" {{ centre_id == id ? 'selected' }}>{{ name }}</option>{% endfor %}
    </select>
</form>
{% endblock %}

{% block content %}
{% set months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'] %}

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    {% macro mini_chart(title, rows, field, color) %}
    <div class="bg-white rounded-xl border border-gray-200 p-5">
        <h3 class="text-sm font-semibold text-gray-700 mb-3">{{ title }}</h3>
        {% set maxVal = rows|map(r => r[field])|max %}
        {% if maxVal > 0 %}
        <div class="flex items-end gap-0.5 h-16">
            {% for row in rows %}
            <div class="flex-1" title="{{ row.mo|slice(0,3) }}: {{ row[field] }}">
                <div class="{{ color }} rounded-sm opacity-80"
                     style="height: {{ [64, (row[field] / maxVal * 64)|round]|min }}px; min-height: 2px"></div>
            </div>
            {% endfor %}
        </div>
        <div class="flex justify-between text-[10px] text-gray-400 mt-1">
            <span>Jan</span><span>Dec</span>
        </div>
        <div class="text-xs text-gray-500 mt-2">Total: <strong>{{ rows|map(r => r[field])|sum|number_format }}</strong></div>
        {% else %}
        <p class="text-sm text-gray-400 py-6 text-center">No data</p>
        {% endif %}
    </div>
    {% endmacro %}

    {{ _self.mini_chart('Attendance', data.attendance, 'total', 'bg-brand-500') }}
    {{ _self.mini_chart('Giving (KES)', data.giving, 'total', 'bg-emerald-500') }}
    {{ _self.mini_chart('New members', data.new_members, 'cnt', 'bg-violet-500') }}
</div>

<!-- Detail table -->
{% if data.attendance %}
<div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
                <th class="text-left px-4 py-3 text-xs font-semibold text-gray-600 uppercase">Month</th>
                <th class="text-right px-4 py-3 text-xs font-semibold text-gray-600 uppercase">Attendance</th>
                {% if data.giving %}<th class="text-right px-4 py-3 text-xs font-semibold text-gray-600 uppercase">Giving</th>{% endif %}
                {% if data.new_members %}<th class="text-right px-4 py-3 text-xs font-semibold text-gray-600 uppercase">New members</th>{% endif %}
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
        {% for mo in 1..12 %}
            {% set att = data.attendance|filter(r => r.mo == mo)|first %}
            {% set giv = data.giving|filter(r => r.mo == mo)|first %}
            {% set nm  = data.new_members|filter(r => r.mo == mo)|first %}
            <tr class="{{ (att or giv or nm) ? 'hover:bg-gray-50' : 'text-gray-300' }}">
                <td class="px-4 py-2.5">{{ months[mo - 1] }}</td>
                <td class="px-4 py-2.5 text-right">{{ att ? att.total|number_format : '—' }}</td>
                {% if data.giving %}<td class="px-4 py-2.5 text-right">{{ giv ? giv.total|number_format(2) : '—' }}</td>{% endif %}
                {% if data.new_members %}<td class="px-4 py-2.5 text-right">{{ nm ? nm.cnt : '—' }}</td>{% endif %}
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<a href="{{ path('insights_reports_index') }}" class="mt-4 inline-block text-sm text-brand-600 hover:underline">← All reports</a>
{% endblock %}
