{% extends 'base.html.twig' %}
{% block title %}Sign-in report{% endblock %}
{% block page_title %}Sign-in report{% endblock %}
{% set church_name = null %}

{% block topbar_actions %}
<form method="get" class="flex items-center gap-2">
    <select name="days" class="rounded-lg border border-gray-300 px-3 py-2 text-sm" onchange="this.form.submit()">
        {% for d in [7, 14, 30, 90] %}
        <option value="{{ d }}" {{ d == days ? 'selected' }}>Last {{ d }} days</option>
        {% endfor %}
    </select>
</form>
{% endblock %}

{% block content %}
<div class="bg-white rounded-xl border border-gray-200 p-5 mb-4">
    <h3 class="text-sm font-semibold text-gray-700 mb-3">Sign-in trend — last {{ days }} days</h3>
    {% set maxCnt = trend|map(r => r.cnt)|max %}
    {% if maxCnt > 0 %}
    <div class="flex items-end gap-1 h-24">
    {% for row in trend %}
        <div class="flex-1 flex flex-col gap-0.5" title="{{ row.day }}: {{ row.ok }}/{{ row.cnt }}">
            <div class="w-full bg-brand-500 rounded-sm opacity-80" style="height: {{ [96, (row.cnt / maxCnt * 96)|round]|min }}px; min-height: 2px"></div>
        </div>
    {% endfor %}
    </div>
    <div class="flex justify-between text-[10px] text-gray-400 mt-1">
        <span>{{ trend|first.day ?? '' }}</span>
        <span>{{ trend|last.day ?? '' }}</span>
    </div>
    {% else %}
    <p class="text-sm text-gray-400 text-center py-8">No sign-in data for this period.</p>
    {% endif %}
</div>

{% if trend %}
<div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
                <th class="text-left px-4 py-3 text-xs font-semibold text-gray-600 uppercase">Date</th>
                <th class="text-right px-4 py-3 text-xs font-semibold text-gray-600 uppercase">Total attempts</th>
                <th class="text-right px-4 py-3 text-xs font-semibold text-gray-600 uppercase">Successful</th>
                <th class="text-right px-4 py-3 text-xs font-semibold text-gray-600 uppercase">Failed</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
        {% for row in trend|reverse %}
        <tr class="hover:bg-gray-50">
            <td class="px-4 py-2.5">{{ row.day }}</td>
            <td class="px-4 py-2.5 text-right">{{ row.cnt }}</td>
            <td class="px-4 py-2.5 text-right text-green-600">{{ row.ok }}</td>
            <td class="px-4 py-2.5 text-right {{ (row.cnt - row.ok) > 0 ? 'text-red-500' : 'text-gray-400' }}">{{ row.cnt - row.ok }}</td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<a href="{{ path('insights_reports_index') }}" class="mt-4 inline-block text-sm text-brand-600 hover:underline">← All reports</a>
{% endblock %}
