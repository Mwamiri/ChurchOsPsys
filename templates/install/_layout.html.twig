<!DOCTYPE html>
<html lang="en" class="">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Install{% endblock %} · ChurchOS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="https://cdn.tailwindcss.com/3.4.1"></script>
    <style>
    .input-field{width:100%;border:1px solid #d1d5db;border-radius:.5rem;padding:.5rem .75rem;font-size:.875rem;outline:none}
    .input-field:focus{border-color:#3b82f6;box-shadow:0 0 0 3px rgba(59,130,246,.15)}
    .form-label{display:block;font-size:.875rem;font-weight:500;color:#374151;margin-bottom:.25rem}
    .btn-primary{display:inline-flex;align-items:center;gap:.375rem;padding:.5rem 1.25rem;border-radius:.5rem;font-size:.875rem;font-weight:500;background:#2563eb;color:#fff;cursor:pointer;border:none}
    .btn-primary:hover{background:#1d4ed8}
    .btn-ghost{display:inline-flex;align-items:center;gap:.375rem;padding:.5rem 1rem;border-radius:.5rem;font-size:.875rem;font-weight:500;color:#6b7280;cursor:pointer;background:transparent;border:none}
    </style>
</head>
<body class="bg-gradient-to-br from-brand-900 via-blue-800 to-blue-600 min-h-screen flex items-center justify-center p-4" style="--tw-gradient-from:#1e3a8a;--tw-gradient-to:#2563eb">
<div class="w-full max-w-xl">
    {# Progress steps #}
    <div class="flex items-center justify-center mb-8 gap-2">
        {% set steps = [
            {step: 1, label: 'Requirements', route: 'install_index'},
            {step: 2, label: 'Database',     route: 'install_database'},
            {step: 3, label: 'Church',       route: 'install_church'},
            {step: 4, label: 'Admin',        route: 'install_admin'},
            {step: 5, label: 'Finish',       route: 'install_finish'},
        ] %}
        {% for s in steps %}
        <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold
                {{ s.step == current_step ? 'bg-white text-blue-800' :
                   s.step < current_step  ? 'bg-blue-500 text-white' :
                   'bg-white/20 text-white/60' }}">
                {{ s.step < current_step ? '✓' : s.step }}
            </div>
            <span class="text-xs text-white/70 hidden sm:inline {{ s.step == current_step ? 'text-white font-medium' : '' }}">{{ s.label }}</span>
            {% if not loop.last %}<div class="w-8 h-px bg-white/20 mx-1"></div>{% endif %}
        </div>
        {% endfor %}
    </div>

    {% block content %}{% endblock %}

    <p class="text-center text-xs text-white/50 mt-6">ChurchOS P Edition · Mwamiri Computers Ltd</p>
</div>
</body>
</html>
