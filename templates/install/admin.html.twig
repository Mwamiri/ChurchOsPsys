{% extends 'install/_layout.html.twig' %}
{% block title %}Administrator — Install{% endblock %}
{% set current_step = 4 %}

{% block content %}
<form method="post" class="bg-white rounded-2xl shadow-xl overflow-hidden">
    <div class="px-6 py-5 border-b border-gray-100">
        <h1 class="text-lg font-semibold text-gray-800"><i class="bi bi-person-badge text-blue-600 mr-2"></i>Step 4 — System Administrator</h1>
    </div>
    <div class="px-6 py-5 space-y-4">
        {% if error %}
        <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700 flex items-start gap-2">
            <i class="bi bi-exclamation-triangle flex-shrink-0 mt-0.5"></i>{{ error }}
        </div>
        {% endif %}
        <p class="text-sm text-gray-500">This account will have full access to all settings and data.</p>
        <div><label class="form-label">Full name <span class="text-red-500">*</span></label><input type="text" name="name" value="{{ state.name ?? '' }}" required class="input-field" placeholder="e.g. John Kamau"></div>
        <div><label class="form-label">Email address <span class="text-red-500">*</span></label><input type="email" name="email" value="{{ state.email ?? '' }}" required class="input-field"></div>
        <div><label class="form-label">Password <span class="text-red-500">*</span></label><input type="password" name="password" required minlength="8" class="input-field" placeholder="Minimum 8 characters"></div>
    </div>
    <div class="px-6 py-4 border-t border-gray-100 flex justify-between">
        <a href="{{ path('install_church') }}" class="btn-ghost"><i class="bi bi-arrow-left"></i> Back</a>
        <button type="submit" class="btn-primary">Review & Finish <i class="bi bi-arrow-right"></i></button>
    </div>
</form>
{% endblock %}
