{% extends 'install/_layout.html.twig' %}
{% block title %}Church — Install{% endblock %}
{% set current_step = 3 %}

{% block content %}
<form method="post" class="bg-white rounded-2xl shadow-xl overflow-hidden">
    <div class="px-6 py-5 border-b border-gray-100">
        <h1 class="text-lg font-semibold text-gray-800"><i class="bi bi-buildings text-blue-600 mr-2"></i>Step 3 — Your church</h1>
    </div>
    <div class="px-6 py-5 space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label class="form-label">Church / ministry name <span class="text-red-500">*</span></label>
                <input type="text" name="church_name" value="{{ state.church_name ?? '' }}" required class="input-field" placeholder="e.g. Deliverance Church Nairobi">
            </div>
            <div>
                <label class="form-label">Headquarters / root name</label>
                <input type="text" name="root_name" value="{{ state.root_name ?? 'Headquarters' }}" class="input-field">
                <p class="text-xs text-gray-400 mt-1">The top-level unit in your hierarchy.</p>
            </div>
        </div>
        <div>
            <label class="form-label">Time zone</label>
            <select name="timezone" class="input-field">
                {% for z in zones %}
                <option value="{{ z }}" {{ (state.timezone ?? 'Africa/Nairobi') == z ? 'selected' : '' }}>{{ z }}</option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label class="form-label">Mode</label>
            <div class="grid grid-cols-2 gap-3 mt-1">
                <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-gray-200 p-3 hover:border-blue-400 has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50">
                    <input type="radio" name="environment" value="production" {{ (state.environment ?? 'production') == 'production' ? 'checked' : '' }} class="mt-0.5">
                    <span><strong class="text-sm">Production</strong><br><span class="text-xs text-gray-500">Live site — errors hidden.</span></span>
                </label>
                <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-gray-200 p-3 hover:border-blue-400 has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50">
                    <input type="radio" name="environment" value="development" {{ (state.environment ?? '') == 'development' ? 'checked' : '' }} class="mt-0.5">
                    <span><strong class="text-sm">Development</strong><br><span class="text-xs text-gray-500">Testing — shows detailed errors.</span></span>
                </label>
            </div>
        </div>
    </div>
    <div class="px-6 py-4 border-t border-gray-100 flex justify-between">
        <a href="{{ path('install_database') }}" class="btn-ghost"><i class="bi bi-arrow-left"></i> Back</a>
        <button type="submit" class="btn-primary">Next: Administrator <i class="bi bi-arrow-right"></i></button>
    </div>
</form>
{% endblock %}
