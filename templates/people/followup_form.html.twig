{% extends 'base.html.twig' %}
{% block title %}New Follow-up — ChurchOS{% endblock %}

{% block body %}
<div class="max-w-lg mx-auto">
  <div class="flex items-center gap-3 mb-6">
    <a href="{{ path('people_followups') }}" class="text-gray-400 hover:text-gray-600">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    </a>
    <h1 class="text-2xl font-bold text-gray-800">New Follow-up</h1>
  </div>

  <form method="post" class="card p-6 space-y-4">
    <div>
      <label class="form-label">Person Name <span class="text-red-500">*</span></label>
      <input type="text" name="person_name" value="{{ fu.person_name ?? '' }}" required class="input-field">
    </div>
    <div>
      <label class="form-label">Phone</label>
      <input type="tel" name="phone" value="{{ fu.phone ?? '' }}" class="input-field">
    </div>
    <div>
      <label class="form-label">Follow-up Type</label>
      <select name="followup_type" class="input-field">
        {% for t in ['pastoral','prayer','counseling','hospital','bereavement','welcome','general'] %}
        <option value="{{ t }}" {{ (fu.followup_type ?? '') == t ? 'selected' : '' }}>{{ t|capitalize }}</option>
        {% endfor %}
      </select>
    </div>
    <div>
      <label class="form-label">Assigned To</label>
      <input type="text" name="assigned_to" value="{{ fu.assigned_to ?? '' }}" class="input-field" placeholder="Leader name">
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="form-label">Follow-up Date</label>
        <input type="date" name="followup_date" value="{{ fu.followup_date ?? 'now'|date('Y-m-d') }}" class="input-field">
      </div>
      <div>
        <label class="form-label">Due Date</label>
        <input type="date" name="due_date" value="{{ fu.due_date ?? '' }}" class="input-field">
      </div>
    </div>
    <div>
      <label class="form-label">Notes</label>
      <textarea name="notes" rows="3" class="input-field">{{ fu.notes ?? '' }}</textarea>
    </div>
    <div class="flex justify-between pt-2 border-t border-gray-100">
      <a href="{{ path('people_followups') }}" class="btn-ghost">Cancel</a>
      <button type="submit" class="btn-primary">Save Follow-up</button>
    </div>
  </form>
</div>
{% endblock %}
