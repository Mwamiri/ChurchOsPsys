{% extends 'base.html.twig' %}
{% block title %}Households — ChurchOS{% endblock %}

{% block body %}
<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-800">Households</h1>
  <div class="flex gap-2">
    <a href="{{ path('people_groups') }}" class="btn-secondary text-sm">Groups</a>
    {% if is_granted('ROLE_CLERK') %}
    <a href="{{ path('ministry_new', {area: 'households'}) }}" class="btn-primary text-sm">New Household</a>
    {% endif %}
  </div>
</div>

<form method="get" class="mb-4 flex gap-2">
  <input type="text" name="q" value="{{ q ?? '' }}" placeholder="Search households…" class="input-field flex-1 text-sm">
  <button type="submit" class="btn-secondary">Search</button>
</form>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
  {% for h in rows %}
  <div class="card p-5 hover:shadow-md transition-shadow">
    <div class="flex items-start justify-between mb-1">
      <h2 class="font-semibold text-gray-800">{{ h.family_name }}</h2>
      <span class="px-2 py-0.5 bg-purple-50 text-purple-700 text-xs rounded-full">{{ h.member_count ?? 0 }} members</span>
    </div>
    {% if h.address %}<p class="text-xs text-gray-500 mb-1">{{ h.address }}</p>{% endif %}
    {% if h.head_of_household %}<p class="text-xs text-gray-400">Head: {{ h.head_of_household }}</p>{% endif %}
    <div class="mt-3 flex gap-2">
      <a href="{{ path('ministry_view', {area: 'households', id: h.id}) }}" class="text-blue-600 hover:underline text-xs">View</a>
      {% if is_granted('ROLE_CLERK') %}
      <a href="{{ path('ministry_edit', {area: 'households', id: h.id}) }}" class="text-gray-500 hover:text-gray-700 text-xs">Edit</a>
      {% endif %}
    </div>
  </div>
  {% else %}
  <div class="col-span-3 card p-8 text-center text-gray-400">No households found.</div>
  {% endfor %}
</div>
{% endblock %}
