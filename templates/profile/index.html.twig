{% extends 'base.html.twig' %}
{% block title %}My Profile — ChurchOS{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-800 mb-6">My Profile</h1>

  <div class="card p-6 mb-4">
    <div class="flex items-center gap-4 mb-6">
      <div class="w-16 h-16 rounded-full bg-blue-600 text-white flex items-center justify-center text-2xl font-bold uppercase">
        {{ user.name|slice(0,1) }}
      </div>
      <div>
        <h2 class="text-xl font-semibold text-gray-800">{{ user.name }}</h2>
        <p class="text-sm text-gray-500">@{{ user.username }} · {{ user.roleLabel }}</p>
        {% if user.centre %}
        <p class="text-sm text-gray-400">{{ user.centre.fullPath }}</p>
        {% endif %}
      </div>
    </div>
    <dl class="grid grid-cols-2 gap-4 text-sm">
      <div><dt class="text-xs text-gray-500 uppercase">Email</dt><dd class="mt-1">{{ user.email ?? '—' }}</dd></div>
      <div><dt class="text-xs text-gray-500 uppercase">Phone</dt><dd class="mt-1">{{ user.phone ?? '—' }}</dd></div>
      <div><dt class="text-xs text-gray-500 uppercase">2FA</dt><dd class="mt-1">{{ user.totpSecret ? '✅ Enabled' : '⚠️ Disabled' }}</dd></div>
      <div><dt class="text-xs text-gray-500 uppercase">Last Login</dt><dd class="mt-1">{{ user.lastLoginAt ? user.lastLoginAt|date('d M Y H:i') : '—' }}</dd></div>
    </dl>
  </div>

  <div class="grid grid-cols-3 gap-3">
    <a href="{{ path('profile_edit') }}" class="card p-4 text-center hover:bg-blue-50 transition-colors">
      <svg class="w-7 h-7 text-blue-600 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      <p class="text-sm font-medium text-gray-700">Edit Profile</p>
    </a>
    <a href="{{ path('profile_password') }}" class="card p-4 text-center hover:bg-blue-50 transition-colors">
      <svg class="w-7 h-7 text-blue-600 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
      <p class="text-sm font-medium text-gray-700">Change Password</p>
    </a>
    <a href="{{ path('profile_2fa') }}" class="card p-4 text-center hover:bg-blue-50 transition-colors">
      <svg class="w-7 h-7 text-blue-600 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
      <p class="text-sm font-medium text-gray-700">Two-Factor Auth</p>
    </a>
  </div>
</div>
{% endblock %}
