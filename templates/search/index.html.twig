{% extends 'base.html.twig' %}
{% block title %}{% if q %}Results for "{{ q }}"{% else %}Search{% endif %} — ChurchOS{% endblock %}
{% block page_title %}{% if q %}Results for "{{ q }}"{% else %}Search{% endif %}{% endblock %}
{% block page_subtitle %}{% if q %}{{ results|length }} match(es) found{% else %}Type at least two letters in the search bar above (Ctrl+K).{% endif %}{% endblock %}

{% block body %}
{% set groups = {} %}
{% for r in results %}
    {% if groups[r.group] is not defined %}{% set groups = groups|merge({(r.group): []}) %}{% endif %}
    {% set groups = groups|merge({(r.group): groups[r.group]|merge([r])}) %}
{% endfor %}

<div class="space-y-4">
    {% for group, items in groups %}
    <div class="card overflow-hidden">
        <div class="flex items-center justify-between px-5 py-3 border-b border-slate-100 dark:border-slate-700">
            <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">{{ group }}</span>
            <span class="text-xs bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400 px-2 py-0.5 rounded-full">{{ items|length }}</span>
        </div>
        <div class="divide-y divide-slate-100 dark:divide-slate-800">
            {% for it in items %}
            <a href="{{ it.url }}" class="flex items-center gap-4 px-5 py-3 text-slate-700 dark:text-slate-200 no-underline hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                <i class="bi bi-{{ it.icon }} text-xl text-brand-600 flex-shrink-0"></i>
                <span>
                    <span class="block font-medium">{{ it.title }}</span>
                    {% if it.sub %}<span class="block text-xs text-slate-400">{{ it.sub }}</span>{% endif %}
                </span>
                <i class="bi bi-chevron-right text-slate-300 ml-auto"></i>
            </a>
            {% endfor %}
        </div>
    </div>
    {% else %}
    {% if q %}
    <div class="card p-12 text-center text-slate-400">
        <i class="bi bi-search text-4xl block mb-2"></i>
        <p>Nothing found for <strong>"{{ q }}"</strong>. Try fewer or different words.</p>
    </div>
    {% else %}
    <div class="card p-12 text-center text-slate-400">
        <i class="bi bi-search text-4xl block mb-2"></i>
        <p>Start typing to search members, visitors, leaders, groups, and more.</p>
        <p class="text-xs mt-1">Keyboard shortcut: <kbd class="bg-slate-100 dark:bg-slate-700 rounded px-1 py-0.5 text-slate-600 dark:text-slate-300">Ctrl K</kbd></p>
    </div>
    {% endif %}
    {% endfor %}
</div>
{% endblock %}
