{% extends 'base.html.twig' %}
{% block title %}SMS — ChurchOS{% endblock %}

{% block body %}
<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-800">SMS</h1>
  <a href="{{ path('sms_compose') }}" class="btn-primary text-sm">Compose SMS</a>
</div>

<div class="card overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200 text-sm">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-4 py-3 text-left font-medium text-gray-500">Recipient</th>
        <th class="px-4 py-3 text-left font-medium text-gray-500">Phone</th>
        <th class="px-4 py-3 text-left font-medium text-gray-500">Message</th>
        <th class="px-4 py-3 text-left font-medium text-gray-500">Status</th>
        <th class="px-4 py-3 text-left font-medium text-gray-500">Sent</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      {% for r in rows %}
      <tr>
        <td class="px-4 py-2.5">{{ r.recipient_name ?? '—' }}</td>
        <td class="px-4 py-2.5 font-mono text-xs">{{ r.phone }}</td>
        <td class="px-4 py-2.5 max-w-xs truncate">{{ r.message }}</td>
        <td class="px-4 py-2.5">
          <span class="px-2 py-0.5 rounded-full text-xs font-medium
            {{ r.status == 'sent' ? 'bg-green-100 text-green-700' : (r.status == 'failed' ? 'bg-red-100 text-red-700' : 'bg-yellow-100 text-yellow-700') }}">
            {{ r.status|capitalize }}
          </span>
        </td>
        <td class="px-4 py-2.5 text-gray-400 text-xs">{{ r.sent_at ? r.sent_at|date('d M Y H:i') : '—' }}</td>
      </tr>
      {% else %}
      <tr><td colspan="5" class="px-4 py-8 text-center text-gray-400">No SMS records.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>

{% if pages > 1 %}
<div class="mt-4 flex gap-1 justify-end">
  {% for p in 1..pages %}
  <a href="{{ path('sms_index', {page: p}) }}"
     class="px-3 py-1 rounded text-sm {{ p == page ? 'bg-blue-600 text-white' : 'bg-gray-100 hover:bg-gray-200' }}">{{ p }}</a>
  {% endfor %}
</div>
{% endif %}
{% endblock %}
