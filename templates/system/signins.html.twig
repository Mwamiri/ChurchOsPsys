{% extends 'base.html.twig' %}
{% block title %}Sign-ins — System — ChurchOS{% endblock %}
{% block page_title %}Sign-in History{% endblock %}
{% block page_subtitle %}Last 200 login attempts{% endblock %}

{% block body %}
{% include 'system/_nav.html.twig' with {active: 'signins'} %}

<div class="card overflow-hidden">
    <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-700 text-sm">
        <thead class="bg-slate-50 dark:bg-slate-800/60">
            <tr>
                <th class="px-4 py-3 text-left font-medium text-slate-500">When</th>
                <th class="px-4 py-3 text-left font-medium text-slate-500">User</th>
                <th class="px-4 py-3 text-left font-medium text-slate-500">Status</th>
                <th class="px-4 py-3 text-left font-medium text-slate-500">IP Address</th>
                <th class="px-4 py-3 text-left font-medium text-slate-500 hidden md:table-cell">User Agent</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            {% for r in rows %}
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/30">
                <td class="px-4 py-2.5 text-slate-400 whitespace-nowrap">{{ r.logged_in_at ? r.logged_in_at|date('d M Y H:i') : '—' }}</td>
                <td class="px-4 py-2.5 font-medium">{{ r.user_name ?? r.email ?? '—' }}</td>
                <td class="px-4 py-2.5">
                    <span class="px-2 py-0.5 text-xs rounded-full
                        {{ r.success ? 'bg-green-50 text-green-700 dark:bg-green-950 dark:text-green-300' : 'bg-red-50 text-red-700 dark:bg-red-950 dark:text-red-300' }}">
                        {{ r.success ? 'Success' : 'Failed' }}
                    </span>
                    {% if r.two_fa_used %}<span class="ml-1 px-2 py-0.5 text-xs rounded-full bg-blue-50 text-blue-700">2FA</span>{% endif %}
                </td>
                <td class="px-4 py-2.5 font-mono text-xs text-slate-500">{{ r.ip_address ?? '—' }}</td>
                <td class="px-4 py-2.5 text-xs text-slate-400 hidden md:table-cell max-w-xs truncate">{{ r.user_agent ? r.user_agent|slice(0,60) ~ (r.user_agent|length > 60 ? '…' : '') : '—' }}</td>
            </tr>
            {% else %}
            <tr><td colspan="5" class="px-4 py-8 text-center text-slate-400">No sign-in records found.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
